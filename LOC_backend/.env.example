# Copy to .env (gitignored) and fill in your own local values.
# docker-compose.yml reads these to provision the local Postgres container.
# Make sure DATABASE_URL below matches these same values.
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=leagueofcoach

# PostgreSQL (match POSTGRES_USER/PASSWORD/DB above, used by docker-compose.yml)
DATABASE_URL="postgresql://changeme:changeme@localhost:5432/leagueofcoach"
PORT=4100

# Clerk auth
CLERK_SECRET_KEY=""

# Riot API access (for data calls that use Riot API key)
RIOT_API_KEY=""
RIOT_DEFAULT_SERVER="LAS"

# Shared secret for the Cloud Scheduler-triggered /internal/poll-ranks endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_POLL_SECRET=""

# Sentry (backend project, from your Sentry project settings)
SENTRY_DSN=""

# Start date (YYYY-MM-DD) of the current ranked split — Pool Champ and
# Aprendizaje only read matches from this date onward. Riot doesn't publish
# this via API, so update it by hand each time a new split starts (roughly
# every 4 months: January / April / August). See src/common/season.ts.
CURRENT_SPLIT_START_DATE="2026-07-29"

# Discord webhooks (one per channel: session-logs, issues-logs, deploys-logs).
# Treat these as secrets: anyone with the URL can post into the channel.
DISCORD_SESSION_WEBHOOK_URL=""
DISCORD_ISSUES_WEBHOOK_URL=""
DISCORD_DEPLOYS_WEBHOOK_URL=""
DISCORD_FEEDBACK_WEBHOOK_URL=""
