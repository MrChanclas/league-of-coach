generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String       @id @default(cuid())
  clerkId   String       @unique
  name      String
  email     String       @unique
  role      String       @default("user")
  createdAt DateTime     @default(now())
  accounts  LolAccount[]
}

model LolAccount {
  id                String             @id @default(cuid())
  summoner          String
  tag               String
  server            String
  puuid             String             @unique
  soloTier          String             @default("Unranked")
  soloDivision      String             @default("Unranked")
  soloLp            Int                @default(0)
  flexTier          String             @default("Unranked")
  flexDivision      String             @default("Unranked")
  flexLp            Int                @default(0)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  learnings         ChampionLearning[]
  goals             Goal[]
  matchParticipants MatchParticipant[]
}

model ChampionLearning {
  id        String            @id @default(cuid())
  champion  String
  role      String
  games     Int               @default(0)
  wins      Int               @default(0)
  kdaK      Float             @default(0)
  kdaD      Float             @default(0)
  kdaA      Float             @default(0)
  csMin     Float             @default(0)
  accountId String
  account   LolAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessions  LearningSession[]
  createdAt DateTime          @default(now())

  @@unique([accountId, champion, role])
}

model LearningSession {
  id         String   @id @default(cuid())
  date       DateTime
  duration   Int
  focus      String
  ratings    Json
  learningId String
  learning   ChampionLearning @relation(fields: [learningId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Goal {
  id        String    @id @default(cuid())
  type      String
  title     String
  progress  Int       @default(0)
  deadline  DateTime?
  accountId String
  account   LolAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Match {
  id           String             @id @default(cuid())
  matchId      String             @unique
  server       String
  gameCreation DateTime
  gameDuration Int
  gameMode     String
  gameVersion  String
  queueId      Int
  participants MatchParticipant[]
  createdAt    DateTime           @default(now())
}

model MatchParticipant {
  id           String     @id @default(cuid())
  matchId      String
  match        Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  accountId    String
  account      LolAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  puuid        String
  champion     String
  championId   Int
  teamPosition String
  win          Boolean
  kills        Int
  deaths       Int
  assists      Int
  csTotal      Int
  goldEarned   Int
  teamId       Int
  createdAt    DateTime   @default(now())

  @@unique([matchId, accountId])
}