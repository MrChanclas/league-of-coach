generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String       @id @default(cuid())
  clerkId               String       @unique
  name                  String
  email                 String       @unique
  role                  String       @default("user")
  createdAt             DateTime     @default(now())
  // Null hasta que el usuario termina o salta el recorrido de onboarding en
  // su primer ingreso al panel. Se guarda en la base (no en localStorage)
  // para que no vuelva a aparecer al cambiar de dispositivo.
  onboardingCompletedAt DateTime?
  accounts              LolAccount[]
}

model LolAccount {
  id                String             @id @default(cuid())
  summoner          String
  tag               String
  server            String
  puuid             String             @unique
  profileIconId     Int                @default(0)
  summonerLevel     Int                @default(0)
  soloTier          String             @default("Unranked")
  soloDivision      String             @default("Unranked")
  soloLp            Int                @default(0)
  flexTier          String             @default("Unranked")
  flexDivision      String             @default("Unranked")
  flexLp            Int                @default(0)
  // Ranked wins/losses as Riot's league-v4 reports them. Unlike anything
  // counted from stored matches, these don't depend on the match list Riot
  // serves for this account, which can stop well short of the season start
  // even though the games exist — so they are what reveals that the stored
  // history is still missing games.
  soloWins          Int                @default(0)
  soloLosses        Int                @default(0)
  flexWins          Int                @default(0)
  flexLosses        Int                @default(0)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())

  // Progress of the season-wide match backfill (see matches.service.ts).
  // `seasonBackfillCursor` is the gameCreation of the oldest game already
  // swept back to; `seasonBackfillDoneFor` holds the season start date for
  // which that sweep reached the end, so a new season (or a gap that opens
  // up when a lot of games are played between syncs) reopens it.
  seasonBackfillCursor  DateTime?
  seasonBackfillDoneFor DateTime?
  learnings         ChampionLearning[]
  goals             Goal[]
  matchParticipants MatchParticipant[]
  rankSnapshots     RankSnapshot[]
  championPool      ChampionPool?
}

model RankSnapshot {
  id         String     @id @default(cuid())
  queueType  String
  tier       String
  division   String
  lp         Int
  accountId  String
  account    LolAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capturedAt DateTime   @default(now())
}

model ChampionLearning {
  id        String            @id @default(cuid())
  champion  String
  role      String
  games     Int               @default(0)
  wins      Int               @default(0)
  kdaK      Float             @default(0)
  kdaD      Float             @default(0)
  kdaA      Float             @default(0)
  csMin     Float             @default(0)
  accountId String
  account   LolAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())

  @@unique([accountId, champion, role])
}

model Goal {
  id        String     @id @default(cuid())
  type      String // 'rango' | 'rol' | 'campeon'
  deadline  DateTime?
  accountId String
  account   LolAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  // type = 'rango'
  queueType      String? // 'solo' | 'flex'
  targetTier     String? // IRON..CHALLENGER
  targetDivision String? // I..IV, null en Master+

  // type = 'rol' (el objetivo se compara contra el benchmark de la banda de
  // rango actual de la cuenta, no un winrate fijo — ver role-performance.ts)
  targetRole String? // TOP | JUNGLE | MIDDLE | BOTTOM | UTILITY

  // type = 'campeon'
  targetWinrate  Float? // 0..1
  targetChampion String?
  targetKda      Float?
}

// Per-champion strategy guide (build/runes-agnostic identity + playstyle
// tips) — see src/champion-guides. `content` follows the JSON shape in
// champion-guides/guide-content.schema.ts so the format can grow (build,
// runas, matchups...) without a schema migration. Hand-authored from
// src/champion-guides/data/manual-guides on first request per champion.
model ChampionGuide {
  id           String   @id @default(cuid())
  championKey  String   @unique // Data Dragon champion key, e.g. "Nilah"
  patchVersion String // Data Dragon version this content was written for
  content      Json
  createdAt    DateTime @default(now())
}

// The champion pool a player declares for an account — what LoC treats as
// "the champions this player actually plays" instead of averaging across
// every champion they've ever touched. One pool per account (not per user):
// someone with a mid account and a support account needs two independent
// pools, and the header's account selector already scopes everything else
// this way. See handoff_loc/07-pool-champ.md.
model ChampionPool {
  id        String      @id @default(cuid())
  accountId String      @unique
  account   LolAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source    String // 'manual' | 'coach' — how the pool was first put together
  entries   PoolEntry[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model PoolEntry {
  id          String       @id @default(cuid())
  poolId      String
  pool        ChampionPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  championKey String // Data Dragon champion id, e.g. "Nilah"
  role        String // TOP | JUNGLE | MIDDLE | BOTTOM | UTILITY — the pool slot, not validated against the champion's "official" role
  state       String       @default("testing") // 'main' | 'secondary' | 'testing'
  note        String? // short, editable — why this champion is in the pool
  addedBy     String       @default("player") // 'player' | 'coach'
  position    Int          @default(0) // display order within the pool
  createdAt   DateTime     @default(now())

  @@unique([poolId, championKey])
}

model Match {
  id           String             @id @default(cuid())
  matchId      String             @unique
  server       String
  gameCreation DateTime
  gameDuration Int
  gameMode     String
  gameVersion  String
  queueId      Int
  participants MatchParticipant[]
  createdAt    DateTime           @default(now())
}

model MatchParticipant {
  id           String      @id @default(cuid())
  matchId      String
  match        Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  accountId    String?
  account      LolAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  puuid        String
  champion     String
  championId   Int
  teamPosition String
  win          Boolean
  kills        Int
  deaths       Int
  assists      Int
  csTotal      Int
  goldEarned   Int
  visionScore  Int         @default(0)
  damageDealt  Int         @default(0)
  itemIds      Int[]       @default([])
  teamId       Int
  createdAt    DateTime    @default(now())

  // Per-role performance metrics, all from Riot's challenges object (see
  // common/role-performance.ts) — nullable because they're null on matches
  // synced before each field was added.
  killParticipation            Float? // 0..1
  teamDamagePercentage         Float? // 0..1, this participant's share of their team's total champion damage
  soloKills                    Int?
  turretTakedowns              Int?
  maxLevelLeadLaneOpponent     Int?
  maxCsAdvantageOnLaneOpponent Float? // vs. the lane opponent, or vs. the enemy jungler for JUNGLE
  dragonTakedowns              Int?
  baronTakedowns               Int?
  riftHeraldTakedowns          Int?
  controlWardsPlaced           Int?
  // Denormalized from the match's team-level objectives (info.teams[].objectives)
  // at ingestion time, so objective participation can be computed per-row
  // without joining back to teammates.
  teamDragonKills              Int?
  teamBaronKills               Int?
  teamRiftHeraldKills          Int?

  // Only populated when this match has a UTILITY participant on a curated
  // "peel" champion (see common/peel-support.ts) paired with a BOTTOM
  // teammate — derived from the Match Timeline API at ingestion time, and
  // written identically onto BOTH of their rows since it's the same shared
  // incident read from two angles ("no más escudos" for the support, "espera
  // a tu compañero" for the ADC). peelAdcDeathsTracked counts the ADC's early
  // deaths (<20min); peelAdcDeathsUnguarded is the subset where the support
  // was not within peel range at the closest timeline frame.
  peelAdcDeathsTracked   Int?
  peelAdcDeathsUnguarded Int?

  // Only populated for a MIDDLE participant — derived from the Match
  // Timeline API at ingestion time (see common/mid-roam.ts).
  // midRoamFramesTracked counts early-game (<25min) timeline frames with a
  // known position; midRoamFramesAway is the subset where they were outside
  // the mid lane corridor, regardless of whether that rotation produced a
  // kill, assist, or objective takedown.
  midRoamFramesTracked Int?
  midRoamFramesAway    Int?

  // How many times this participant cast Teleport, straight from Riot's
  // summonerXCasts field (see common/summoner-spells.ts) — no timeline
  // needed, Riot already counts it. Null when they didn't equip Teleport at
  // all, so "brought it and never cast it" (0) can be told apart from
  // "didn't bring it" (null).
  teleportCasts Int?

  @@unique([matchId, puuid])
}
