# Backend API URL used in development
VITE_API_URL=http://localhost:4100

# Clerk publishable key (from your Clerk dashboard)
VITE_CLERK_PUBLISHABLE_KEY=

# Sentry DSN (from your Sentry project settings). DSNs are safe to expose
# client-side (they only accept event submissions), so this doubles as the
# production value baked into the frontend build.
VITE_SENTRY_DSN=
